# Default Wisp configuration for the Umbrel package. On first start this file
# is copied to /data/wisp.toml. Edit the copy (Files -> Apps -> Wisp -> data)
# and restart the app to apply changes. See docs/configuration.md upstream for
# every option.

[server]
# Must stay 0.0.0.0 inside the container so Umbrel's proxy and your
# LAN/Tor clients can reach the relay.
host = "0.0.0.0"
port = 7777

[relay]
name = "My Wisp Relay"
description = "A private Nostr relay"
# pubkey = "your_hex_pubkey"
# contact = "admin@example.com"

[storage]
path = "/data/wisp"
# map_size_mb = 10240
# sync = "meta"

[limits]
max_connections = 1000
workers = 0
max_subscriptions = 20
max_filters = 10
max_message_size = 65536
max_event_tags = 2000
max_content_length = 102400
query_limit_default = 500
query_limit_max = 5000
query_scan_multiplier = 20

[rate_limits]
events_per_minute = 120
queries_per_minute = 300

[timeouts]
idle_seconds = 300

[auth]
# required = false
# to_write = false
# relay_url = ""

[security]
# The Umbrel package fronts Wisp with its built-in GUI/proxy, which forwards
# websocket upgrades and NIP-11 requests to the relay on 127.0.0.1 and injects
# the real client IP in X-Forwarded-For. trust_proxy + this whitelist keeps
# per-IP limits keyed to the actual client; only peers on the list may set
# forwarded headers, so it cannot be forged by clients.
trust_proxy = true
trusted_proxies = "127.0.0.1"

[spider]
# Syncs events from people you follow on public relays. Set admin to your
# hex pubkey to fetch your contact list and sync your feed.
enabled = true
relays = "wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band"
sync_interval = 300
admin = ""

[negentropy]
enabled = true
max_sync_events = 100000
max_sessions = 4

[management]
# NIP-86 relay management. Comma-separated hex pubkeys allowed to run admin
# commands.
# admin_pubkeys = ""

[watchdog]
enabled = true
interval_seconds = 10
timeout_ms = 2000
failures = 4

[retention]
# Age-based purge of old events, run by the management GUI (the relay itself
# ignores this section). A background worker deletes events older than
# purge_after_months once per interval_hours (30-day months). Deleted events
# get tombstones so sync cannot re-add them.
enabled = false
purge_after_months = 12
# keep_admin_notes = true retains every event authored by the [spider] admin
# (and [management] admin_pubkeys) indefinitely, regardless of age.
keep_admin_notes = true
interval_hours = 24

[feed]
# Feed tab in the management GUI. The GUI reads this relay's LMDB directly
# and crawls the original poster's read relays (their kind 10002 relay list)
# for replies and zaps that were never stored here. Replies from authors
# outside the poster's web-of-trust (their follows and their follows'
# follows) are hidden unless the reply carries NIP-13 proof-of-work of at
# least pow_threshold leading zero bits. Zaps are always shown, since they
# carry a monetary cost.
enabled = true
bootstrap_relays = "wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net"
pow_threshold = 16
max_depth1 = 200
cache_ttl_hours = 24
crawl_timeout_s = 8
